# GEMINI_API_KEY: Optional (unused unless Gemini features are enabled)
GEMINI_API_KEY=""

# APP_URL: Public URL of your deployed service (leave empty locally)
APP_URL=""

# Optional: Only set VITE_API_BASE_URL if frontend & backend are hosted on separate domains.
# Leave empty when Express serves both dist/ and /api/* on the same origin.
VITE_API_BASE_URL=""
ALLOWED_ORIGIN=""

# Firebase Web App Configuration (Explicit per environment)
# Only public Web SDK values belong here; never put Admin SDK private keys in VITE_* vars.
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_DATABASE_ID=""

# ==============================================================================
# Server-Side SmartPOS Owner Integration (NEVER prefix with VITE_, NEVER commit)
# FAIL-CLOSED: OWNER_FIREBASE_PROJECT_ID, OWNER_FIRESTORE_DATABASE_ID, and STORE_ID
# MUST be explicitly set per environment (no automatic fallback; "(default)" is rejected).
# Keep staging and production completely isolated; never copy production values to staging.
# ==============================================================================
STORE_ID=""
OWNER_FIREBASE_PROJECT_ID=""
OWNER_FIRESTORE_DATABASE_ID=""

# On Google Cloud Run:
# Leave FIREBASE_SERVICE_ACCOUNT / FIREBASE_SERVICE_ACCOUNT_JSON unset if using ADC.
# The backend authenticates via Google Cloud Application Default Credentials (ADC)
# using the runtime service account configured for that isolated environment.

# Optional ONLY for non-GCP hosting (e.g. Render without GCP Metadata Server):
FIREBASE_SERVICE_ACCOUNT_JSON=""
# FIREBASE_CLIENT_EMAIL=""
# FIREBASE_PRIVATE_KEY=""

# ==============================================================================
# Server-Side KiriminAja Shipping Integration (NEVER prefix with VITE_)
# ==============================================================================
KIRIMINAJA_API_KEY=""
KIRIMINAJA_BASE_URL="https://tdev.kiriminaja.com"
KIRIMINAJA_ORIGIN_DISTRICT_ID=""
KIRIMINAJA_TIMEOUT_MS="8000"
# Set ONLY after verifying the exact Mitra API location search path in your KiriminAja dashboard/Postman:
KIRIMINAJA_LOCATION_SEARCH_PATH=""
KIRIMINAJA_LOCATION_SEARCH_METHOD="GET"

# ==============================================================================
# Server-Side RajaOngkir / Komerce Shipping Cost Adapter (NEVER prefix with VITE_)
# ==============================================================================
RAJAONGKIR_API_KEY=""
RAJAONGKIR_BASE_URL="https://rajaongkir.komerce.id/api/v1"
RAJAONGKIR_ORIGIN_ID=""
RAJAONGKIR_TIMEOUT_MS="8000"



